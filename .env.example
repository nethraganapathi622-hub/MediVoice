# ==============================================================================
# MediVoice - Environment Configuration Template
# Copy this file to .env or backend/.env in your local environment.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="MediVoice API"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Discrete parameters (RECOMMENDED if password contains special characters like @, #, %, !)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_actual_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=medivoice_db

# Option B: Complete Connection String
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/medivoice_db
DATABASE_CONNECT_TIMEOUT=5

# Optional: Separate database for live PostgreSQL integration tests
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/medivoice_test_db

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# In production, must be at least 32 characters and cryptographically random
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# AI Voice Assistant & Gemini LLM Provider (Optional)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMERGENCY_CONTACT_PHONE="+91 (44) 2829 0200"
EMERGENCY_AMBULANCE_NUMBER="108"
# NOTIFICATION_WEBHOOK_URL=https://your-hospital-sms-gateway.example.com/webhook

# ------------------------------------------------------------------------------
# Frontend Service Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

