# ==============================================================================
# MediVoice Backend - Environment Configuration Template
# Copy this file to backend/.env (or root .env) for local development.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

PROJECT_NAME="MediVoice API"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# CORS origins: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option A (Recommended if password contains special characters like @, #, %, !):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_actual_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=medivoice_db

# Option B: Full Connection String
# Note: If your password contains special characters, percent-encode them
# (e.g., '@' -> '%40', '#' -> '%23', '%' -> '%25')
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/medivoice_db
DATABASE_CONNECT_TIMEOUT=5

# Optional: Separate database for live PostgreSQL integration tests
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/medivoice_test_db

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# In production, must be at least 32 characters and cryptographically random
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# AI Voice Assistant & Gemini LLM Provider (Optional)
# ------------------------------------------------------------------------------
# If GEMINI_API_KEY is not provided, MediVoice safely uses its built-in clinical
# rule-based fallback parser so tests and local development run without an API key.
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMERGENCY_CONTACT_PHONE="+91 (44) 2829 0200"
EMERGENCY_AMBULANCE_NUMBER="108"

# ------------------------------------------------------------------------------
# Multilingual Hospital Notification Service (Optional)
# ------------------------------------------------------------------------------
# If set, SMS/WhatsApp notification events will be forwarded to this webhook URL.
# If omitted, notifications are recorded in the database audit log and telemetry endpoint.
# NOTIFICATION_WEBHOOK_URL=https://your-hospital-sms-gateway.example.com/webhook

